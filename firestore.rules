rules_version = '2';

// v2 (personal logins). Paste into the TEST Firebase project only (Firestore > Rules), never the live one.
//
// - Everyone signs in with their own email, and the email must be confirmed.
// - A new account gets a profile with status "pending". Pending or denied accounts can read and write nothing.
// - Only the admin (the email listed in adminEmails below) can approve accounts or list them.
// - A trip lists the emails that can open it ("members"). Anyone on a trip can add people;
//   only the trip's planner ("owner") can remove them. Nobody can see a trip they're not on.
service cloud.firestore {
  match /databases/{database}/documents {
    // BEFORE PUBLISHING: replace this with your own sign-in email, in lowercase.
    function adminEmails() { return ['you@example.com']; }

    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email; }
    function isAdmin() { return verified() && myEmail() in adminEmails(); }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function approved() {
      return verified() && (isAdmin() || (exists(profilePath()) && get(profilePath()).data.status == 'approved'));
    }
    function smallDoc() { return request.resource.data.size() <= 40; }
    function shortText(v, n) { return v is string && v.size() > 0 && v.size() <= n; }

    // ---------- accounts ----------
    match /users/{uid} {
      allow get: if (verified() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      // You can only create your own profile, as "pending", with your own confirmed email.
      allow create: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'status', 'created'])
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data.name, 60)
        && request.resource.data.created is string && request.resource.data.created.size() <= 40;
      // The admin changes status; you can change only your own name.
      allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['pending', 'approved', 'denied'])
        || (verified() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && shortText(request.resource.data.name, 60));
      allow delete: if isAdmin();
    }

    // ---------- saved families (just a list of names and emails for adding people to trips) ----------
    match /families/{fid} {
      function familyOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'people', 'editors'])
          && shortText(d.name, 60)
          && d.people is list && d.people.size() <= 40
          && d.editors is list && d.editors.size() <= 41 && myEmail() in d.editors;
      }
      allow get, list: if approved() && myEmail() in resource.data.editors;
      allow create: if approved() && familyOk();
      allow update: if approved() && myEmail() in resource.data.editors && familyOk();
      allow delete: if approved() && myEmail() in resource.data.editors;
    }

    // ---------- trips ----------
    match /trips/{trip} {
      function membersOk() {
        let m = request.resource.data.members;
        return m is list && m.size() <= 60 && request.resource.data.owner in m;
      }
      allow get, list: if approved() && myEmail() in resource.data.members;
      allow create: if approved() && request.resource.data.owner == myEmail() && membersOk() && smallDoc();
      allow update: if approved() && myEmail() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && membersOk() && smallDoc()
        && (resource.data.owner == myEmail() || request.resource.data.members.hasAll(resource.data.members));
      allow delete: if approved() && resource.data.owner == myEmail();

      // The trip's plans and lists: anyone on the trip.
      match /{coll}/{item} {
        function onTrip() {
          return approved() && myEmail() in get(/databases/$(database)/documents/trips/$(trip)).data.members;
        }
        function validColl() { return coll in ['plans', 'wishes', 'tasks', 'packing']; }
        allow get, list: if validColl() && onTrip();
        allow create, update: if validColl() && onTrip() && smallDoc();
        allow delete: if validColl() && onTrip();
      }
    }
  }
}
